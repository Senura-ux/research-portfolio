ADMIN_PASSWORD=replace-with-a-long-random-password
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Contact form (Nodemailer over SMTP). For Gmail, use a 16-character App Password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=replace-with-your-app-password
# Optional: defaults to senuradinilka5@gmail.com
CONTACT_TO_EMAIL=senuradinilka5@gmail.com
# Optional: defaults to "AI EyeDx Website" <SMTP_USER>
# CONTACT_FROM_EMAIL=AI EyeDx <your-sending-account@gmail.com>
KV_REST_API_URL=https://your-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=replace-with-your-upstash-token
